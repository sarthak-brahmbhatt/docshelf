<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain-http traffic so the app can reach a DocShelf backend on the local network (no TLS on LAN). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
