# DocShelf environment template. Copy to .env (git-ignored), then edit. Never commit .env.
#
# Quick start:   cp .env.example .env && make key   (make key writes a fresh DOCSHELF_MASTER_KEY)
# Every variable has a default in docker-compose.yml, so the stack boots even with an empty .env.

# ---------- Database (postgres service) ----------
# Inside Docker the backend is always pointed at the "postgres" service; these two host/port values
# are only used when you run the backend on the Mac directly (make backend-run).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docshelf
POSTGRES_USER=docshelf
# Change this if port 5432 is ever exposed beyond 127.0.0.1.
POSTGRES_PASSWORD=docshelf

# ---------- Mail (mailpit service) ----------
# Mailpit captures every e-mail; nothing is delivered to a real inbox. UI: http://localhost:8025
# Like POSTGRES_HOST, these are for local (non-Docker) backend runs; Compose uses mailpit:1025.
MAIL_HOST=localhost
MAIL_PORT=1025
# Sender / owner address used for reminder e-mails and shares.
DOCSHELF_MAIL_FROM=docshelf@localhost
DOCSHELF_MAIL_TO=owner@localhost

# ---------- Security (REQUIRED to change) ----------
# Master key: 32 random bytes, base64. Everything at rest (blobs, ID numbers, PDF passwords) is
# encrypted under keys derived from it. LOSE IT AND YOUR BACKUPS ARE UNREADABLE.
# The value below is only an example. Replace it with the output of:  scripts/gen-master-key.sh
DOCSHELF_MASTER_KEY=e+EZo3WLdbtQzqTbxSIRP8aE2ZC1ebTT3QL5o0K8EUA=
# Static bearer token every /api/** request must carry (the phone app stores it in Settings).
# Any long random string works, e.g.  openssl rand -hex 24
DOCSHELF_API_TOKEN=28b9d733b7273a92efa16f20681928b0e41e3bf0c5519a03

# ---------- Uploads / storage ----------
# Maximum size of a single upload in MB (any MIME type is accepted).
DOCSHELF_MAX_UPLOAD_MB=200
# Where encrypted blobs live. Inside Docker this is fixed to /data/blobs (named volume "blobs").
DOCSHELF_BLOB_DIR=./data/blobs

# ---------- OpenAI (optional, enables AI features) ----------
# Leave blank to run without AI: uploads, OCR and rule-based classification still work; LLM
# extraction, summaries, embeddings/semantic search and chat are disabled with a clear message.
OPENAI_API_KEY=
# Chat + tool loop model.
OPENAI_CHAT_MODEL=gpt-4.1
# Structured field extraction / classification fallback (cheaper model is fine).
OPENAI_EXTRACT_MODEL=gpt-4.1-mini
# Embeddings for hybrid search (1536 dims; must match the vector column size in db/migration).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Speech-to-text for voice notes and voice commands.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# When true, handwritten prescriptions and low-confidence OCR images are sent to OpenAI vision
# AS IMAGES (pixels cannot be redacted). Set false to keep all images on this machine.
DOCSHELF_VISION_ENABLED=true

# ---------- WhatsApp sharing (stubbed in v1) ----------
# STUB records a SIMULATED send and delivers nothing. META uses the WhatsApp Cloud API (off by default).
WHATSAPP_PROVIDER=STUB
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_NAME=docshelf_share

# ---------- Misc ----------
# Zone used for reminders, "today" in chat, and scheduled jobs.
DOCSHELF_TIMEZONE=Asia/Kolkata
